{
    "name": "Duckiebot ROS 1 Dev",

    // Wir sagen VS Code, es soll ein fertiges Image von Docker Hub verwenden.
    // "daffy" ist die Duckiebot-Version, die auf ROS Noetic basiert.
    "image": "duckietown/dt-ros-commons:daffy-amd64",

    // Wir "spiegeln" (mounten) immer noch unseren Code in den Container
    "workspaceMount": "source=${localWorkspaceFolder}/packages,target=/ws/src,type=bind,consistency=cached",
    
    // Der Arbeitsordner in diesem Image ist /ws
    "workspaceFolder": "/ws",

    // Installiere diese Erweiterungen automatisch IM Container
    "extensions": [
        "ms-vscode.cpptools",
        "ros-tooling.ros",
        "ms-vscode.cmake-tools"
    ],

    // Wir brauchen keinen "postCreateCommand" mehr, da alles schon
    // im Image installiert ist (auch duckietown_msgs).
    
    // DIESE ZEILE WURDE ENTFERNT: "overrideCommand": false,
    //
    // Wenn wir sie entfernen, wird der Standardwert (true) verwendet.
    // Das bedeutet, VS Code überschreibt den Standard-Befehl des Images
    // (der 'roslaunch' startet) und fügt stattdessen einen
    // "sleep"-Befehl ein, um den Container für die Entwicklung 
    // am Laufen zu halten.

    // Wir ändern die "runArgs", um nur "--init" zu behalten.
    // Das Überschreiben des "--entrypoint" ist bei ROS-Images
    // sehr problematisch, da sonst die Umgebungs-Setup-Skripte 
    // (wie setup.bash) nicht geladen werden.
    "runArgs": ["--init"]
}